#  Relevant files

InitCondFile = ICS/IC
OutputDir = output
TreeCoolFile = ../TREECOOL_hm_2012
# OutputList = 0.05,0.1,0.11, 0.15,0.166666, 0.17857, 0.1923, 0.2,0.299,0.3,0.33333,0.4,0.5,0.66666,0.75,0.9
# Put z=4.2, 4.6, 5.0
OutputList = 0.16666, 0.17857, 0.192307

# CPU time -limit

TimeLimitCPU = 100000 #= 24 hours
SplitGravityTimestepsOn = 1

# Code options
# Characteristics of run
TimeMax = 1.00000

Omega0 = 0.3209          # Total matter density  (at z=0)
OmegaLambda = 0.6791     # Cosmological constant (at z=0)
OmegaBaryon = 0.0494     # Baryon density        (at z=0)
HubbleParam = 0.669      # Hubble paramater (may be used for power spec parameterization)

CoolingOn = 1
StarformationOn = 1
BlackHoleOn = 0
HydroOn = 1
MetalReturnOn = 0
DensityIndependentSphOn = 0
DensityKernelType = cubic
StarformationCriterion = density
RadiationOn = 1
MassiveNuLinRespOn = 0
WindOn = 0
#MetalCoolFile = ""

SnapshotWithFOF = 1
FOFHaloLinkingLength = 0.2
FOFHaloMinLength = 32

MaxMemSizePerNode = 1500000

#----------------------SFR Stuff-------------------------

CritPhysDensity = 1000       #  critical physical density for star formation in
#  hydrogen number density in cm^(-3)

QuickLymanAlphaProbability = 1
# Set to 1.0 to turn dense gas directly into stars.
WindModel = nowind
